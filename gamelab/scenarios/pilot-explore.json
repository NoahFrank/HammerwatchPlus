{
 "name": "pilot-explore",
 "about": "P6b travel gate: an exploration run (\"explore\": true). floor_runner takes dark_citadel floor 0's exit; the forest_1 -> forest_2 transition, absent from authored.json and learned.json, is appended to gamelab/travel/learned.json with this run's id (new_edge and learned both true). Run it with the edge absent from learned.json.",
 "fixture": "mission-ranger",
 "timeout": 400,
 "steps": [
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "dark_citadel",
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 120
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "gl",
   "verb": "scan",
   "args": [
    400
   ],
   "save_as": "scan0",
   "expect": {
    "ok": true,
    "place": "dark_citadel/forest_1",
    "exitCount": {
     "between": [
      1,
      20
     ]
    }
   },
   "name": "floor 0 has a level exit"
  },
  {
   "do": "shot",
   "name": "floor 0"
  },
  {
   "do": "bot",
   "name": "exploration: new transition learned",
   "save_as": "bot",
   "expect": {
    "terminal": "next_floor",
    "place_to": "dark_citadel/forest_2",
    "new_edge": true,
    "learned": true
   },
   "bot": "floor_runner"
  },
  {
   "do": "gl",
   "verb": "scan",
   "args": [
    400
   ],
   "save_as": "scan1",
   "expect": {
    "ok": true,
    "place": "dark_citadel/forest_2"
   },
   "name": "probe agrees: on floor 1"
  },
  {
   "do": "shot",
   "name": "floor 1"
  },
  {
   "do": "log_clean"
  }
 ],
 "explore": true
}