{
 "name": "pilot-floor",
 "about": "P6b promoted scenario: the floor_runner bot of pilot-crosslevel plus assertions (next floor reached, alive, under 120 s, at most 6 exit attempts), lab mode hidden and muted. Telemetry and screenshots must agree: both shots are real frames and the frame changed with the level (shot_changed), else the run is INVALID. The bot travels through the travel graph (Pilot.travel to dark_citadel/forest_2).",
 "fixture": "mission-ranger",
 "timeout": 300,
 "steps": [
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "dark_citadel",
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 120
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "gl",
   "verb": "scan",
   "args": [
    400
   ],
   "save_as": "scan0",
   "expect": {
    "ok": true,
    "place": "dark_citadel/forest_1",
    "exitCount": {
     "between": [
      1,
      20
     ]
    }
   },
   "name": "floor 0 has a level exit"
  },
  {
   "do": "shot",
   "name": "floor 0"
  },
  {
   "do": "bot",
   "name": "floor_runner: next floor, alive, under 120 s",
   "save_as": "bot",
   "expect": {
    "terminal": "next_floor",
    "place_to": "dark_citadel/forest_2",
    "seconds": {
     "between": [
      0,
      120
     ]
    },
    "exit_attempts": {
     "between": [
      1,
      6
     ]
    }
   },
   "bot": "floor_runner",
   "kwargs": {
    "to_place": "dark_citadel/forest_2"
   }
  },
  {
   "do": "gl",
   "verb": "scan",
   "args": [
    400
   ],
   "save_as": "scan1",
   "expect": {
    "ok": true,
    "place": "dark_citadel/forest_2"
   },
   "name": "probe agrees: on floor 1"
  },
  {
   "do": "shot",
   "name": "floor 1"
  },
  {
   "do": "gl",
   "verb": "state",
   "name": "alive on floor 1",
   "expect": {
    "ok": true,
    "player.dead": false
   }
  },
  {
   "do": "shot_changed",
   "before": "floor 0",
   "after": "floor 1"
  },
  {
   "do": "log_clean"
  }
 ]
}