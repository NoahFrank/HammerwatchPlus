%include "tweak/missions/marker.inc"

<!-- The Forsaken Tower: HoH1's six acts as HoH2 themes, two generated floors
     and a vanilla boss per act, 18 floors from diff 5 to 22. Set hwp_campaign
     is only offered by the town portal (doodads/hwp/forsaken_portal.unit). -->
<loader>MissionDef::LoadSingle</loader>
<dict>
	<string name="id">hwp_forsaken_tower</string>
	<string name="name">.mission.hwp_forsaken_tower.name</string>
	<string name="description">.mission.hwp_forsaken_tower.desc</string>
	<string name="set">hwp_campaign</string>
	<float name="spawn-chance">1.0</float>

	<array name="conditionals"><a>
		<s>flag</s><s>is</s><s>mission_story_intro_find_npcs</s>
	</a></array>

	%block MissionMarkerPurple 128 96

	<int name="base-diff-level">5</int>
	<array name="levels">

