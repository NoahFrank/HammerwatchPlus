	<!-- <string name="set">mission_board</string> -->

%if !DEMO_BUILD
	<bool name="reward-ngp">true</bool>
%endif

	<array name="conditionals"><a>
		<s>flag</s><s>is</s><s>mission_story_intro_find_npcs</s>
	</a></array>

