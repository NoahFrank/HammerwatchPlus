<gui>
	<sprites>
		%include "gui/panel_decoration.inc"
	</sprites>

	<doc>
		<group id="root" anchor="0.5 0" offset="0 4" width="236" height="116">
			<panel id="panel" anchor="0 0" width="236" height="116" style="standard">
				<text id="title" text=".hwp.deathrecap.title" color="#ff6666" font="title" align="center" anchor="0.5 0" offset="0 5" width="220" />
				<text id="toggle" text="[-]" color="#c0c0c0" font="text" align="right" anchor="1 0" offset="-8 6" width="20" />
				<text id="total" text="" color="#ffd27f" font="text" align="center" anchor="0.5 0" offset="0 21" width="220" />
				<text id="line0" text="" color="#ffffff" font="text" anchor="0 0" offset="10 36" width="216" />
				<text id="line1" text="" color="#ffffff" font="text" anchor="0 0" offset="10 48" width="216" />
				<text id="line2" text="" color="#ffffff" font="text" anchor="0 0" offset="10 60" width="216" />
				<text id="line3" text="" color="#ffffff" font="text" anchor="0 0" offset="10 72" width="216" />
				<text id="line4" text="" color="#ffffff" font="text" anchor="0 0" offset="10 84" width="216" />
			</panel>
		</group>
	</doc>
</gui>
