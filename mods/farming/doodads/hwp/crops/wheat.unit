<!-- Wheat (ready, vanilla crop sprite) (purely visual, spawned locally by HWP::Farming::RefreshVisuals). -->
<unit slot="doodad" netsync="none">
	<scenes default="plant">
		<scene name="plant">
			<sprite origin="7 20" texture="doodads/terrain/crops.png" material="system/default.mats:proj-prop">
				<frame>108 0 14 22</frame>
			</sprite>
		</scene>
	</scenes>
</unit>
