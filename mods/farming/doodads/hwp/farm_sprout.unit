<!-- Growing crop (purely visual, spawned locally by HWP::Farming::RefreshVisuals). -->
<unit slot="doodad" netsync="none">
	<scenes default="plant">
		<scene name="plant">
			<sprite origin="8 14" texture="doodads/hwp/farm.png" material="system/default.mats:proj-prop">
				<frame>32 0 16 16</frame>
			</sprite>
		</scene>
	</scenes>
</unit>
