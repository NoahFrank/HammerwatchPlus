<gui>
	<sprites>
		%include "gui/scalablebutton_sprites.inc"
		%include "gui/panel_decoration.inc"
		%include "gui/closebutton_sprites.inc"
	</sprites>

	<doc>
		<group>
			<panel width="320" height="276" anchor="0.5 0.5" style="standard">
				<panel anchor="0.5 0" width="300" height="22" offset="0 0" style="character_pick_top">
					<text id="title" text=".hwp.fishing.pirate.title" color="#ed9331" font="title" align="center" anchor="0.5 0.5" width="280" offset="0 1" />
				</panel>
				<button id="close-btn" nav-pos="4 0" spriteset="close-button" anchor="1 0" offset="-2 2" func="close" />

				<text id="greeting" text="" color="#ffd27f" font="text" align="center" anchor="0.5 0" offset="0 30" width="296" />
				<text id="status" text="" color="#ffffff" font="text" align="center" anchor="0.5 0" offset="0 66" width="296" />
				<text id="message" text="" color="#9fd8ff" font="text" align="center" anchor="0.5 0" offset="0 100" width="296" />
				<text id="gold" text="" color="#ffd27f" font="text" align="center" anchor="0.5 0" offset="0 132" width="296" />

				<scalebutton id="bait-btn" nav-pos="0 4" spriteset="scalebutton-regular" width="96" anchor="0 1" offset="10 -10" func="bait" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="bait20-btn" nav-pos="1 4" spriteset="scalebutton-regular" width="96" anchor="0.5 1" offset="0 -10" func="bait20" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="rod-btn" nav-pos="2 4" spriteset="scalebutton-regular" width="96" anchor="1 1" offset="-10 -10" func="rod" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="shrimp-btn" nav-pos="0 3" spriteset="scalebutton-regular" width="146" anchor="0 1" offset="10 -40" func="shrimp" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="squid-btn" nav-pos="1 3" spriteset="scalebutton-regular" width="146" anchor="1 1" offset="-10 -40" func="squid" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="sell-btn" nav-pos="0 2" spriteset="scalebutton-regular" width="146" anchor="0 1" offset="10 -70" func="sell" text="" font="gui/fonts/arial11.fnt" />
				<scalebutton id="trap-btn" nav-pos="1 2" spriteset="scalebutton-regular" width="146" anchor="1 1" offset="-10 -70" func="trap" text="" font="gui/fonts/arial11.fnt" />
			</panel>
		</group>
	</doc>
</gui>
