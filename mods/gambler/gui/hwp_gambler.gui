<gui>
	<sprites>
		%include "gui/scalablebutton_sprites.inc"
		%include "gui/panel_decoration.inc"
		%include "gui/closebutton_sprites.inc"
		%include "gui/hwp_gambler_cards.inc"
	</sprites>

	<doc>
		<group>
			<panel width="360" height="377" anchor="0.5 0.5" style="standard">
				<!-- Title -->
				<panel anchor="0.5 0" width="280" height="22" offset="0 0" style="character_pick_top">
					<text text=".hwp.gambler.title" color="#ed9331" font="title" align="center" anchor="0.5 0.5" width="260" offset="0 1" />
				</panel>

				<!-- Close button -->
				<button id="close-btn" nav-pos="4 0" spriteset="close-button" anchor="1 0" offset="-2 2" func="close" />

				<!-- Gold display -->
				<rect width="160" height="20" anchor="0.5 0" offset="0 28" spriteset="gui/sprite_rect.sval:rounded">
					<text text=".hwp.gambler.gold_label" color="#ffd700" font="text" anchor="0 0.5" offset="8 0" />
					<text id="gold-amount" text="0" color="#ffffff" font="text" anchor="1 0.5" offset="-8 0" />
				</rect>

				<!-- Cards display area -->
				<group width="340" height="100" anchor="0.5 0" offset="0 55">
					<!-- Player side -->
					<text text=".hwp.gambler.you" color="#ed9331" font="text" align="center" anchor="0 0" offset="45 -2" />
					<sprite id="player-deck-sprite" src="card-back" width="60" height="90" anchor="0 0" offset="10 10" />
					<sprite id="player-card-sprite" width="60" height="90" anchor="0 0" offset="80 10" />

					<!-- VS text -->
					<text text="vs" color="#888888" font="title" align="center" anchor="0.5 0" offset="0 35" />

					<!-- Dealer side -->
					<text text=".hwp.gambler.dealer" color="#ed9331" font="text" align="center" anchor="1 0" offset="-45 -2" />
					<sprite id="dealer-card-sprite" width="60" height="90" anchor="1 0" offset="-80 10" />
					<sprite id="dealer-deck-sprite" src="card-back" width="60" height="90" anchor="1 0" offset="-10 10" />
				</group>

				<!-- Result text -->
				<rect width="300" height="40" anchor="0.5 0" offset="0 160" spriteset="gui/sprite_rect.sval:rounded">
					<text id="result-text" text=".hwp.gambler.bet_prompt" color="#ffffff" font="text" align="center" anchor="0.5 0.5" width="280" />
				</rect>

				<!-- Selected bet display -->
				<rect width="300" height="24" anchor="0.5 0" offset="0 205" spriteset="gui/sprite_rect.sval:rounded">
					<text text=".hwp.gambler.selected_bet" color="#ed9331" font="text" anchor="0 0.5" offset="8 0" />
					<text id="selected-bet" text="100" color="#00ff00" font="text" anchor="1 0.5" offset="-8 0" />
				</rect>

				<!-- Bet selection buttons -->
				<group width="300" height="30" anchor="0.5 0" offset="0 235" flow="hbox" spacing="2">
					<scalebutton id="bet-btn-0" nav-pos="0 1" spriteset="scalebutton-regular" width="50" func="bet-0" text="100" font="gui/fonts/arial11.fnt" />
					<scalebutton id="bet-btn-1" nav-pos="1 1" spriteset="scalebutton-regular" width="50" func="bet-1" text="1K" font="gui/fonts/arial11.fnt" />
					<scalebutton id="bet-btn-2" nav-pos="2 1" spriteset="scalebutton-regular" width="50" func="bet-2" text="10K" font="gui/fonts/arial11.fnt" />
					<scalebutton id="bet-btn-3" nav-pos="3 1" spriteset="scalebutton-regular" width="50" func="bet-3" text="100K" font="gui/fonts/arial11.fnt" />
					<scalebutton id="bet-btn-4" nav-pos="4 1" spriteset="scalebutton-regular" width="50" func="bet-4" text="1M" font="gui/fonts/arial11.fnt" />
				</group>

				<!-- Gear reroll: pick an equipped slot, pay 2000 gold x item level (or 1 bet token per 5 item levels) for new modifiers -->
				<rect width="340" height="28" anchor="0.5 0" offset="0 270" spriteset="gui/sprite_rect.sval:rounded">
					<scalebutton id="reroll-prev" nav-pos="0 2" spriteset="scalebutton-regular" width="34" anchor="0 0.5" offset="4 0" func="reroll-prev" text=".hwp.gambler.prev" font="gui/fonts/arial11.fnt" />
					<text id="reroll-item" text="" color="#ffffff" font="text" align="center" anchor="0 0.5" offset="42 0" width="160" />
					<scalebutton id="reroll-next" nav-pos="1 2" spriteset="scalebutton-regular" width="34" anchor="0 0.5" offset="206 0" func="reroll-next" text=".hwp.gambler.next" font="gui/fonts/arial11.fnt" />
					<scalebutton id="reroll-btn" nav-pos="2 2" spriteset="scalebutton-regular" width="92" anchor="1 0.5" offset="-4 0" func="reroll" text=".hwp.gambler.reroll" font="gui/fonts/arial11.fnt" />
				</rect>

				<!-- Bet tokens (fish sell for them) and the token reroll -->
				<rect width="340" height="28" anchor="0.5 0" offset="0 302" spriteset="gui/sprite_rect.sval:rounded">
					<text id="token-amount" text="" color="#9fd8ff" font="text" align="left" anchor="0 0.5" offset="8 0" width="220" />
					<scalebutton id="reroll-tok-btn" nav-pos="2 3" spriteset="scalebutton-regular" width="92" anchor="1 0.5" offset="-4 0" func="reroll-tokens" text=".hwp.gambler.reroll" font="gui/fonts/arial11.fnt" />
				</rect>

				<!-- Play button -->
				<scalebutton id="play-btn" nav-pos="2 4" spriteset="scalebutton-regular" width="120" anchor="0.5 1" offset="0 -10" func="play" text=".hwp.gambler.flip" font="gui/fonts/arial11.fnt" />

				<!-- Sell wares (HWP::Market: fish, crops, herbs) -->
				<scalebutton id="sell-btn" nav-pos="0 4" spriteset="scalebutton-regular" width="110" anchor="0 1" offset="8 -10" func="sell" text=".hwp.gambler.sell_none" font="gui/fonts/arial11.fnt" />
			</panel>
		</group>
	</doc>
</gui>
