		<float name="speed-mul">1.13</float>
	</dict>
	<dict name="hwp_morale_5">
		<string name="name">.hwp.pets.buff.morale</string>
		<string name="description">.hwp.pets.buff.hwp_morale_5.desc</string>
		<array name="tags"><string>buff</string></array>
