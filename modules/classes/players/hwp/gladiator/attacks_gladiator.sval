<loader order="-2">Item::ItemSkillDef::LoadMultiple</loader>

<!-- The vanilla attack_thrust_spear is marked NOT USED; this is the same thrust
     under our own ids so the trident can reference it. -->
<array>
	<dict>
		<string name="name">.skills.hwp_gladiator.trident.name</string>
		<string name="description">.skills.hwp_gladiator.trident.desc?dmg=100%</string>
		<array name="icon"><s>players/hwp/gladiator/icons.png</s><i>100</i><vec4>144 24 24 24</vec4></array>
		<string name="id">hwp_attack_trident</string>
		<string name="type">mainhand</string>
		<array name="tags"><s>weapon</s><s>melee</s><s>spear</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
			<string name="anim">attack</string>
			<int name="anim-length">600</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.2</float>
			<ivec2 name="move-speed">0 300</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 300</ivec2>

			<int name="castpoint">200</int>
			<bool name="repeating">true</bool>
			<ivec2 name="update-aim">0 200</ivec2>

			<dict name="actions">
				<array name="cast">
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/attacks/mainhand/spear_thrust</string>
					</dict>
