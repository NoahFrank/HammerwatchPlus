								<bool name="melee">true</bool>
								<bool name="off-hand">false</bool>
								<float name="mul">1</float>
							</dict>
							<dict>
								<string name="class">PlaySound</string>
								<string name="sound">event:/sfx/player/attacks/mainhand/spear_thrust_hit</string>
							</dict>
						</array>
					</dict>
				</array>
			</dict>

			<array name="timeline">
				<i>200</i><s>cast</s>
			</array>
		</dict>
	</dict>

	<dict>
