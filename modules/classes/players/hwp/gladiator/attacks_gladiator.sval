						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/attacks/thrust_attack_1.effect?thrust_range=40&=thrust_width=16</string>
						<bool name="send-angle">true</bool>
					</dict>
					<dict>
						<string name="class">MeleeSwing</string>
						<int name="dist">40</int>
						<int name="rays">1</int>
						<int name="ray-num">3</int>
						<int name="ray-width">16</int>
						<int name="interval">0</int>
