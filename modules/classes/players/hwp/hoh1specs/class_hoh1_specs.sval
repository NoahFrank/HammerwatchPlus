		<int name="base-foc">10</int>
		<int name="base-vit">8</int>
		<int name="level-str">0</int>
		<int name="level-dex">0</int>
		<int name="level-int">0</int>
		<int name="level-foc">0</int>
		<int name="level-vit">0</int>
		<int name="foc-spellpwr">2</int>

		<int name="base-health">100</int>
