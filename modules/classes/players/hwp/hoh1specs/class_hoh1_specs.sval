<loader order="1">PlayerClass::LoadMultiple</loader>

<!-- HoH1-style masteries for the vanilla Priest and Paladin: a 4th subclass
     each (the skill trainer and character creation list subclasses by
     parent, any count). Stats are copies of the parents' SharedStats blocks
     (players/priest/class_priest.sval, players/paladin/class_paladin.sval);
     keep them in sync after patches. Skills live in skills/. -->
<array>

	<dict>
		<string name="parent">priest</string>
		<string name="id">hwp_priest_hoh1</string>
		<string name="name">.skills.hwp_priest_hoh1.mastery.name</string>
		<string name="description">subclass of priest</string>

		<array name="icon"><s>players/icons_skills.png</s><i>100</i><vec4>0 24 24 24</vec4></array>

		<array name="skills">
			<string>players/attacks/dash.sval</string>
			<string>players/priest/skills/pri_inner_light.sval</string>
			<string>players/priest/skills/pri_consecrated_ground.sval</string>
			<string>players/priest/skills/pri_divine_protection.sval</string>
			<string>players/priest/skills/pri_divine_favor.sval</string>
			<string>players/hwp/hoh1specs/skills/smite.sval</string>
