		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>9s</s></array>
	</array>

	<array name="icon"><s>players/hwp/thief/icons.png</s><i>100</i><vec4>48 0 24 24</vec4></array>

	<string name="id">hwp_thief_smoke</string>
