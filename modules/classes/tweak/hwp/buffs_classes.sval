<!-- Self-buffs of the HoH1 classes (ActorBuffDef dicts, referenced as
     tweak/hwp/buffs_classes.sval:<id> by the skills). -->
<svals>
	<dict name="hwp_thief_slice">
		<string name="name">.skills.hwp_thief.slice.name</string>
		<string name="description">.skills.hwp_thief.slice.buff.desc</string>
		<array name="hud"><s>items/icons_consumables.png</s><i>100</i><vec4>225 297 14 14</vec4></array>
		<array name="tags"><string>buff</string></array>
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<float name="attack-speed">1.3</float>
	</dict>

	<dict name="hwp_thief_cloak">
