					<bool name="hit-self">true</bool>
					<bool name="hit-same-team">false</bool>
					<bool name="hit-different-team">false</bool>
					<array name="effects">
						<dict>
							<bool name="only-actors">true</bool>
							<float name="self-dmg">1</float>
							<float name="team-dmg">0</float>
							<float name="enemy-dmg">0</float>
						</dict>
						<dict>
							<string name="class">GivePercentageMana</string>
							<string name="mana-bind">reload-frac</string>
							<bool name="curr-mana">false</bool>
						</dict>
						<dict>
							<string name="class">SpawnEffect</string>
							<string name="effect">effects/generic/other/spawn_smoke_puff.effect</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>

		<array name="timeline">
			<i>550</i><s>cast</s>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_2</int>
			<int name="cooldown">1800</int>
