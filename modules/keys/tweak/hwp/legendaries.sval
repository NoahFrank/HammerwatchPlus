<!-- Red legendaries: HoH1's seven (items/legendary.sval in the HoH1 install),
     rebuilt with HoH2 modifiers as Equipment::UniqueEquipment. drop-rate 0
     keeps them out of the generic unique roll; only ace chests
     (HWP::Keys::SpawnAceBonus) hand them out. Icons are trinket-sheet gems
     until the HoH1 icons are imported. -->
<loader>Equipment::UniqueEquipment::LoadMultiple</loader>
<array>

	<dict>
		<string name="id">hwp_descending_destruction</string>
		<string name="name">.item.hwp_descending_destruction.name</string>
		<string name="desc">.item.hwp_descending_destruction.desc</string>
		<string name="slot">head</string>
		<string name="quality">legendary</string>
		<int name="price">100000</int>
		<int name="drop-rate">0</int>
		<array name="tags"><string>hwp_legendary</string></array>
		<array name="icon"><string>items/icons_trinkets.png</string><int>100</int><vec4>96 0 16 16</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::TriggerEffect</string>
				<string name="trigger">hit</string>
				<float name="chance">0.10</float>
				<int name="timeout">50</int>
				<bool name="target-self">false</bool>
				<dict name="effect">
					<string name="class">SpawnUnit</string>
					<array name="units"><int>1000</int><string>players/items/meteor.unit</string></array>
					<bool name="safe-spawn">false</bool>
					<int name="spawn-dist">0</int>
				</dict>
			</dict>
		</array>
	</dict>

