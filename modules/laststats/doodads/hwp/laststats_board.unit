<!-- Notice board that shows the party's last-run statistics. Modelled on the
     base doodads/generic/mission_board.unit (which is compiled out in release
     builds) and reuses its texture. Interact class: HWPLastStatsBoard. -->
<unit slot="doodad">
	<behavior class="CompositeActorBehaviorNPC">
		<int name="hp">100000</int>
		<bool name="targetable">false</bool>
		<int name="experience-reward">0</int>

		<int name="aggro-range">150</int>
		<int name="max-range">300</int>

		<bool name="must-see-target">true</bool>
		<bool name="no-buffs">true</bool>
		<bool name="hide-health">true</bool>
		<bool name="hide-damage-numbers">true</bool>
		<bool name="hide-damage-flash">true</bool>

		<vec2 name="icon-offset">-1 -25</vec2>
		<vec3 name="dialog-offset">0 -24 0</vec3>

		<array name="tags">
		</array>

		<dict name="interact">
			<string name="class">HWPLastStatsBoard</string>
			<int name="break-distance">50</int>
			<array name="icon"><s>gui/icons.png</s><i>100</i><vec4>45 236 16 20</vec4></array>
		</dict>

		<dict name="movement">
			<string name="class">EmptyMovement</string>
		</dict>

		<array name="skills" />
	</behavior>

	<scenes tier-1="board">
		<scene name="board">
			<minimap_sprite origin="7 12" layer="120" texture="gui/minimap.png" frame="42 104 14 14" />
			<collision>
				<rect>-22 0 44 5</rect>
				<rect sensor="true">-22 0 44 35</rect>
			</collision>
			<sprite origin="22 34" texture="doodads/generic/mission_board.png" material="system/default.mats:proj-prop">
				<frame>0 0 44 41</frame>
			</sprite>
			<sprite origin="15 33" texture="doodads/generic/mission_board.png" material="system/default.mats:shadow">
				<frame>0 41 40 38</frame>
			</sprite>
			<sprite origin="18 23" ulayer="1" texture="doodads/generic/mission_board.png" material="system/default.mats:proj-prop">
				<frame>0 79 13 17</frame>
			</sprite>
			<sprite origin="3 23" ulayer="1" texture="doodads/generic/mission_board.png" material="system/default.mats:proj-prop">
				<frame>13 79 9 11</frame>
			</sprite>
			<sprite origin="-9 16" ulayer="1" texture="doodads/generic/mission_board.png" material="system/default.mats:proj-prop">
				<frame>13 90 9 11</frame>
			</sprite>
		</scene>
	</scenes>
</unit>
