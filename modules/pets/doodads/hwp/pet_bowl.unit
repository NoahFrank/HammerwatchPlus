<!-- The pet feeding bowl in town. Interact class HWPPetBowl opens the pet
     menu (level, skills, feeding, pickup toggles). Spawned locally on every
     machine by HWPPetsModule at pets.bowl_x / pets.bowl_y. -->
<unit slot="doodad" netsync="none">
	<behavior class="HWPLocalNPC">
		<int name="hp">100000</int>
		<bool name="targetable">false</bool>
		<int name="experience-reward">0</int>
		<int name="aggro-range">150</int>
		<int name="max-range">300</int>
		<bool name="must-see-target">true</bool>
		<bool name="no-buffs">true</bool>
		<bool name="hide-health">true</bool>
		<bool name="hide-damage-numbers">true</bool>
		<bool name="hide-damage-flash">true</bool>
		<vec2 name="icon-offset">0 -18</vec2>
		<vec3 name="dialog-offset">0 -16 0</vec3>
		<array name="tags"></array>
		<dict name="interact">
			<string name="class">HWPPetBowl</string>
			<int name="break-distance">50</int>
			<array name="icon"><s>doodads/hwp/pets.png</s><i>100</i><vec4>32 0 16 16</vec4></array>
		</dict>
		<dict name="movement">
			<string name="class">EmptyMovement</string>
		</dict>
		<array name="skills" />
	</behavior>

	<scenes default="bowl">
		<scene name="bowl">
			<minimap_sprite origin="4 4" layer="120" texture="gui/minimap.png" frame="56 83 9 9" />
			<collision>
				<rect sensor="true">-14 -10 28 20</rect>
			</collision>
			<sprite origin="16 12" texture="doodads/hwp/pets.png" material="system/default.mats:floor">
				<frame>0 0 32 20</frame>
			</sprite>
		</scene>
	</scenes>
</unit>
