<effect looping="true">
	<!-- The candle's Secret Sense family skill (HWP::Pets::SkillRunner.UpdateSecrets):
	     a rapid flicker while the candle hovers by a secret entrance. -->
	%replace tl (t+l)

	<light origin="0 0" pos-x="1" pos-y="-11">
		<sprite texture="effects/lights/light2_L.png">
		<frame>0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="900" />

		<size value="62+22*sin(tl*pi*26)+14*sin(tl*pi*58)" />

		<color-r value="0.42+0.12*sin(tl*pi*34)" />
		<color-g value="0.34+0.1*sin(tl*pi*34)" />
		<color-b value="0.12" />
		<color-a value="0.15" />

		<cast-shadows value="false" />
		<shadow-cast-pos-x value="0" />
		<shadow-cast-pos-y value="0" />
	</light>
</effect>
